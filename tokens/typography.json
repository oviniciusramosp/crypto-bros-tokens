    "title1": {
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "28px", "fontWeight": 700, "lineHeight": "34px", "letterSpacing": "0px" },
      "$extensions": { "com.cryptobros.ios": { "relativeTo": "title" } }
    },
    "title2": {
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "22px", "fontWeight": 700, "lineHeight": "28px", "letterSpacing": "0px" },
      "$extensions": { "com.cryptobros.ios": { "relativeTo": "title2" } }
    },
